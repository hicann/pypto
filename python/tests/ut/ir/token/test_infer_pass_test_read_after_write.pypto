function foo incast(logical_tensor %a, logical_tensor %b) outcast() #type(Opaque) #entry(false) {
    logical_tensor %$0, token %$0_w, token %b_r = EXP(%b) token();
    logical_tensor %a_1, token %a_1_w, token %$0_r = ASSEMBLE(%$0) token(%$0_w);
    logical_tensor %$1, token %$1_w, token %a_1_r = EXP(%a_1) token(%a_1_w);
    logical_tensor %$2, token %$2_w, token %a_1_r = EXP(%a_1) token(%a_1_w);
    return %a_1, %b;
}
