function foo incast(logical_tensor %a, logical_tensor %b, logical_tensor %c) outcast() #type(Opaque) #entry(false) {
    logical_tensor %$0, token %$0_w, token %b_r = EXP(%b) token();
    logical_tensor %a_1, token %a_1_w, token %$0_r = ASSEMBLE(%$0) token(%$0_w);
    logical_tensor %$1, token %$1_w, token %c_r = EXP(%c) token();
    logical_tensor %a_3, token %a_3_w, token %$1_r = ASSEMBLE(%$1) token(%$1_w, %a_1_w);
    logical_tensor %$2, token %$2_w, token %a_3_r = EXP(%a_3) token(%a_3_w);
    return %a_3, %b, %c;
}
