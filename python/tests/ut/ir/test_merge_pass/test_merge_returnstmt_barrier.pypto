function foo incast(logical_tensor %x, logical_tensor %y, logical_tensor %z) outcast() #type(Opaque) #entry(false) {
    logical_tensor %z_3 = if scalar_expr then {
        logical_tensor %$0 = ADD(%x, %y) token();
        logical_tensor %z_1 = ASSEMBLE(%$0) token();
