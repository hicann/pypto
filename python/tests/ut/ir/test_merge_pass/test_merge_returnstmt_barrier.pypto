function foo incast(logical_tensor %x, logical_tensor %y, logical_tensor %z) outcast() #type(Opaque) #entry(false) {
    logical_tensor %z = if scalar_expr then {
        logical_tensor %$0 = ADD(%x, %y) token();
        logical_tensor %z = ASSEMBLE(%$0) token();
        yield %z;
    }
    else {
        logical_tensor %$1 = SUB(%x, %y) token();
        logical_tensor %z = ASSEMBLE(%$1) token();
        yield %z;
    }
    return %x, %y, %z;
}
