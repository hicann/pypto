import torch
import pypto.extensions.torch_custom_op_litenpu


def add_kernel_body(input0, input1):
    pypto.set_vec_tile_shapes(*add_infer_tileshape(input0, input1))
    return input0 + input1


def add_infer_tileshape(input0, input1):
    return (1, 4, 1, 64)


def add_infer_shape(input0_shape: torch.Size, input1_shape: torch.Size) -> torch.Size:
    return input0_shape


def add_infer_dtype(input0_dtype: torch.dtype, input1_dtype: torch.dtype) -> torch.dtype:
    return input0_dtype


def create_add_kernel(shape, dtype, soc_version, run_mode=pypto.RunMode.SIM):
    @pypto.frontend.jit(
        codegen_options={"soc_version": soc_version},
        runtime_options={"run_mode": run_mode},
    )
    def add_kernel(
        input0: pypto.Tensor([...], dtype),
        input1: pypto.Tensor([...], dtype),
        output: pypto.Tensor([...], dtype),
    ):
        output.move(add_kernel_body(input0, input1))

    return add_kernel



_custom_op_compile = pypto.extensions.torch_custom_op_litenpu.CompileEntry(
    factory=create_add_kernel,
    factory_signature="single", num_inputs=2, num_outputs=1,
)
_custom_op_compile.infer_shape = add_infer_shape
_custom_op_compile.infer_dtype = add_infer_dtype


def __pypto_compile(in_shapes, in_dtypes, attrs, soc_version):
    return _custom_op_compile(
        tuple(tuple(s) for s in in_shapes), tuple(str(d) for d in in_dtypes),
        dict(attrs), soc_version,
    )
