namespace {

std::tuple<int64_t, int64_t> inferDtype(int64_t a_dtype, int64_t b_dtype) {
    PTO_CUSTOM_LOGD("Entering inferDtype\n");
    // One-time CPython bootstrap for a non-Python host (GE/Ascend executor that dlopen'd this .so);
    // guarded so a Python host is untouched, and never finalized (called repeatedly; re-init is fragile).
    static const bool _pypto_py_bootstrapped = []() {
        if (!Py_IsInitialized()) {
            Py_InitializeEx(0);   // 0: don't install signal handlers (library-friendly)
            PyEval_SaveThread();  // drop the GIL the init thread holds; reacquired below
        }
        return true;
    }();
    (void)_pypto_py_bootstrapped;

    // Held across the try AND the catch: error_already_set handling needs the GIL.
    py::gil_scoped_acquire gil;
    const std::string _dtype_bridge_src = R"PYSRC(
import torch

_GE_INT_TO_TORCH_BASE = {0: 'float32', 1: 'float16', 2: 'int8', 3: 'int32', 4: 'uint8', 6: 'int16', 7: 'uint16', 8: 'uint32', 9: 'int64', 10: 'uint64', 11: 'float64', 12: 'bool', 16: 'complex64', 17: 'complex128', 18: 'qint8', 19: 'qint16', 20: 'qint32', 21: 'quint8', 22: 'quint16', 27: 'bfloat16', 33: 'complex32'}
_TORCH_BASE_TO_GE_INT = {b: i for i, b in _GE_INT_TO_TORCH_BASE.items()}

def _ge_data_type_enum_value_to_torch_dtype(value):
    import torch
    try:
        base = _GE_INT_TO_TORCH_BASE[value]
    except KeyError:
        raise ValueError('Unsupported ge::DataType enum value for torch mapping: ' + repr(value))
    td = getattr(torch, base, None)
    if td is None:
        raise ValueError('torch has no dtype attribute ' + repr(base))
    return td

def _torch_dtype_to_ge_data_type_enum_value(dtype):
    dtype_name = str(dtype)
    if not dtype_name.startswith('torch.'):
        raise ValueError('Unsupported dtype for GE mapping: ' + repr(dtype))
    base = dtype_name.replace('torch.', '', 1)
    try:
        return _TORCH_BASE_TO_GE_INT[base]
    except KeyError:
        raise ValueError('Unsupported torch dtype for GE enum mapping: ' + repr(dtype))

def _torch_dtype_to_ge_data_type_enum_value_recursive(value):
    if isinstance(value, tuple):
        return tuple(_torch_dtype_to_ge_data_type_enum_value(v) for v in value)
    return _torch_dtype_to_ge_data_type_enum_value(value)

)PYSRC";
    const std::string _import_by_path_src = R"PYSRC(
import importlib.util as _pypto_ilu
_pypto_spec = _pypto_ilu.spec_from_file_location('_pypto_infer_inferDtype', '/nonexistent/pypto_ut_infer_defs.py')
_pypto_infer_mod = _pypto_ilu.module_from_spec(_pypto_spec)
_pypto_spec.loader.exec_module(_pypto_infer_mod)
)PYSRC";

    py::dict globals;                       // FRESH dict per call; py::exec auto-seeds __builtins__
    py::exec(_dtype_bridge_src, globals, globals);     // torch + dtype bridge
    py::exec(_import_by_path_src, globals, globals);   // load the .py defining infer_dtype_two_outputs
    py::object _mod = globals["_pypto_infer_mod"];
    py::object infer_dtype_two_outputs_py = _mod.attr("infer_dtype_two_outputs");
    py::object _ge_dt_to_torch = globals["_ge_data_type_enum_value_to_torch_dtype"];
    py::object _torch_dt_to_ge = globals["_torch_dtype_to_ge_data_type_enum_value_recursive"];

    std::tuple<int64_t, int64_t> _ret = _torch_dt_to_ge(infer_dtype_two_outputs_py(_ge_dt_to_torch(py::cast(a_dtype)), _ge_dt_to_torch(py::cast(b_dtype)))).cast<std::tuple<int64_t, int64_t>>();
    PTO_CUSTOM_LOGD("Exiting inferDtype (ok)\n");
    return _ret;
}

}
